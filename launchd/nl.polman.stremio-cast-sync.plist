<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>nl.polman.stremio-cast-sync</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string><string>-u</string>
    <string>__REPO__/remote/cast-sync.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__REPO__/backups/cast-sync.log</string>
  <key>StandardErrorPath</key><string>__REPO__/backups/cast-sync.log</string>
</dict></plist>
